# ==========================================
# Agent1 - 化工合规 AI 平台环境变量配置模板
# 使用方式: cp .env.example .env 然后按需修改
# 演示账号见 README（勿把本文件中的占位符用于生产）
# ==========================================

# ═══════════════════════════════════════
# PostgreSQL 数据库连接（必填）
# ═══════════════════════════════════════
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chemical_park_ai_agent
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ═══════════════════════════════════════
# JWT 签名密钥（生产必填，至少 32 字符）
# ═══════════════════════════════════════
JWT_KEY=change-me-jwt-key-at-least-32-chars

# ═══════════════════════════════════════
# 账号配置（JSON 数组，密码支持明文或 BCrypt 哈希）
# 演示默认：admin / changeme    auditor / changeme
# ==========================================
AUTH_ACCOUNTS_JSON='[{"Username":"admin","Password":"changeme","Role":"admin"},{"Username":"auditor","Password":"changeme","Role":"auditor"}]'

# ═══════════════════════════════════════
# 服务端口（可选，注释则用默认值）
# ═══════════════════════════════════════
# API_PORT=5000
# WEB_PORT=80              # 前端 Nginx（浏览器入口；Windows 无管理员权限时建议 8088）
# LLAMA_PORT=8080          # llama.cpp LLM 推理端口
# LLAMA_EMBED_PORT=8081    # llama.cpp Embedding 端口
# LLAMA_VISION_PORT=8083   # llama.cpp 视觉 / OCR（GPU 栈；CPU 默认不起）
# ENABLE_VISION_OCR=true   # 不设则 docker-up 按显存自动决定（≥20GB 开）。24GB+ / 4090 不要写成 false。true|false 强制覆盖。CPU 模式脚本会写成 false
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# ═══════════════════════════════════════
# GGUF 模型目录（挂载到 llama 容器 /models，不打进镜像）
# 默认 ./models；也可指向仓库外目录
# 需要:
#   Qwen_Qwen3-8B-Q4_K_M.gguf
#   nomic-embed-text-v1.5.f16.gguf
# GPU 视觉 / OCR 另需:
#   Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
#   mmproj-Qwen2.5-VL-7B-Instruct-f16.gguf
# ═══════════════════════════════════════
# MODELS_PATH=./models
# 校验 / 可选下载：powershell -File scripts/download-models.ps1
# 若设置 AGENT1_MODEL_BASE_URL（末尾不要斜杠），脚本会按文件名 GET {URL}/{filename}

# ═══════════════════════════════════════
# 发布镜像（阶段 B：GPU 冒烟后填写；现在保持注释）
# 不要接入 compose 插值，以免空仓库导致 compose pull 失败
# ═══════════════════════════════════════
# AGENT1_IMAGE_REGISTRY=
# AGENT1_IMAGE_TAG=0.1.0

# ═══════════════════════════════════════
# 法规语料目录（挂载到 api 容器 /app/knowledgebase，不打进 Git）
# .env 里填宿主机路径，供 compose 插值；容器内进程仍用 /app/knowledgebase
# 默认 ./knowledgebase，需含 国标/ 化工专业条例/ 园区规则/ 历史案例/
# 国标 PDF 不要提交进仓库
# ═══════════════════════════════════════
# KNOWLEDGE_BASE_PATH=./knowledgebase


# ═══════════════════════════════════════
# 运行时环境
# ═══════════════════════════════════════
# ASPNETCORE_ENVIRONMENT=Production
# CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173
# Docker / Nginx 同域反代保持 HTTP，不要开跳转（开了会刷 https 端口警告）
# ENABLE_HTTPS_REDIRECT=true

# ═══════════════════════════════════════
# LLM 端点 (P0-2: 覆盖 appsettings.json)
# Docker 内自动设为 http://llama-server:8080/v1
# 裸机 llama.cpp 部署: http://localhost:8080/v1
# 裸机 Ollama 部署:   http://localhost:11434
# 无 GPU 演示档: 设 LLM_OPTIONAL=true，跳过 LLM 走规则引擎
# ═══════════════════════════════════════
# LLM_ENDPOINT=http://localhost:8080/v1
# LLM_OPTIONAL=true

# ═══════════════════════════════════════
# 告警邮件 SMTP 配置（生产必填，授权码只写本机 .env）
# ═══════════════════════════════════════
# ALERT_EMAIL_PASSWORD=your-smtp-auth-code
# ALERT_RECIPIENT_EMAILS=admin@example.com

# ═══════════════════════════════════════
# OpenTelemetry / Seq（可选；不设则不连，避免刷 localhost 失败日志）
# ═══════════════════════════════════════
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# SEQ_URL=http://seq:5341

# ═══════════════════════════════════════
# AutoDL 开放平台 API 令牌（可选，scripts/autodl-*.ps1 使用）
# 只写本机 .env，勿提交
# ═══════════════════════════════════════
# AUTODL_TOKEN=your-autodl-token

# ═══════════════════════════════════════
# Grafana 管理员账号（可选）
# ═══════════════════════════════════════
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=changeme-grafana

# ═══════════════════════════════════════
# 集成测试数据库连接（本地开发 + CI 共用）
# 本地跑集成测试前确保 PostgreSQL 已启动:
#   dotnet test --filter "Category=Integration"
# ═══════════════════════════════════════
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=chemical_park_ai_agent
# DB_USERNAME=postgres
# DB_PASSWORD=changeme
