# ==========================================
# Agent1 - 化工合规 AI 平台环境变量配置模板
# 使用方式: cp .env.example .env 然后按需修改
# 演示账号见 README（勿把本文件中的占位符用于生产）
# ==========================================

# ═══════════════════════════════════════
# PostgreSQL 数据库连接（必填）
# ═══════════════════════════════════════
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chemical_park_ai_agent
DB_USERNAME=postgres
DB_PASSWORD=changeme

# ═══════════════════════════════════════
# JWT 签名密钥（生产必填，至少 32 字符）
# ═══════════════════════════════════════
JWT_KEY=your-jwt-key-at-least-32-chars

# ═══════════════════════════════════════
# 账号配置（JSON 数组，密码支持明文或 BCrypt 哈希）
# 演示默认：admin / changeme    auditor / changeme
# ==========================================
AUTH_ACCOUNTS_JSON=[{"Username":"admin","Password":"changeme","Role":"admin"},{"Username":"auditor","Password":"changeme","Role":"auditor"}]

# ═══════════════════════════════════════
# 服务端口（可选，注释则用默认值）
# ═══════════════════════════════════════
# API_PORT=5000
# LLAMA_PORT=8080          # llama.cpp LLM 推理端口
# LLAMA_EMBED_PORT=8081    # llama.cpp Embedding 端口
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000

# ═══════════════════════════════════════
# 运行时环境
# ═══════════════════════════════════════
# ASPNETCORE_ENVIRONMENT=Production
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ═══════════════════════════════════════
# LLM 端点 (P0-2: 覆盖 appsettings.json)
# Docker 内自动设为 http://llama-server:8080/v1
# 裸机 llama.cpp 部署: http://localhost:8080/v1
# 裸机 Ollama 部署:   http://localhost:11434
# 无 GPU 演示档: 设 LLM_OPTIONAL=true，跳过 LLM 走规则引擎
# ═══════════════════════════════════════
# LLM_ENDPOINT=http://localhost:8080/v1
# LLM_OPTIONAL=true

# ═══════════════════════════════════════
# 知识库路径 (P0-1: 跨平台覆盖)
# Docker 内自动设为 /app/knowledgebase
# 国标全文不入库，运行时自备合法副本到此目录
# ═══════════════════════════════════════
# KNOWLEDGE_BASE_PATH=/app/knowledgebase

# ═══════════════════════════════════════
# 告警邮件 SMTP 配置（生产必填，授权码只写本机 .env）
# ═══════════════════════════════════════
# ALERT_EMAIL_PASSWORD=your-smtp-auth-code
# ALERT_RECIPIENT_EMAILS=admin@example.com

# ═══════════════════════════════════════
# OpenTelemetry (可选，分布式追踪)
# ═══════════════════════════════════════
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ═══════════════════════════════════════
# AutoDL 开放平台 API 令牌（可选，scripts/autodl-*.ps1 使用）
# 只写本机 .env，勿提交
# ═══════════════════════════════════════
# AUTODL_TOKEN=your-autodl-token

# ═══════════════════════════════════════
# Grafana 管理员账号（可选）
# ═══════════════════════════════════════
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=changeme-grafana

# ═══════════════════════════════════════
# 集成测试数据库连接（本地开发 + CI 共用）
# 本地跑集成测试前确保 PostgreSQL 已启动:
#   dotnet test --filter "Category=Integration"
# ═══════════════════════════════════════
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=chemical_park_ai_agent
# DB_USERNAME=postgres
# DB_PASSWORD=changeme
