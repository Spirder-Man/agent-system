# ═══════════════════════════════════════════════
# llama.cpp CUDA 编译版 + server 运行镜像
# 
# 使用方式:
#   docker build -f Dockerfile.llama -t agent1-llama-cuda .
#   docker run --gpus all -p 8080:8080 \
#     -v /path/to/models:/models \
#     agent1-llama-cuda \
#     -m /models/qwen3-8b-q4_k_m.gguf --host 0.0.0.0 --port 8080
# ═══════════════════════════════════════════════

# ── Stage 1: CUDA + 编译 llama.cpp ──
FROM nvidia/cuda:12.4.0-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nvidia*.list || true; \
    chmod 644 /etc/apt/trusted.gpg.d/*.gpg || true; \
    apt-get update --allow-insecure-repositories && \
    apt-get install -y --no-install-recommends --allow-unauthenticated \
    git build-essential cmake libcurl4-openssl-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

# 克隆 llama.cpp（repo 已迁移至 ggml-org，GitHub 自动 301 重定向）
# Qwen3 >= b5092；--mmproj（D01）>= b5331；tools+stream（D03）约 b5478。
# 钉 b5512：b5478 打开 stream+tools 后含 #13786 崩溃修复。这是构建目标，不是 3070/4090 实测。
RUN git clone --depth 1 --branch b5512 \
    https://github.com/ggml-org/llama.cpp.git . || \
    git clone --depth 1 --branch b5512 \
    https://github.com/ggerganov/llama.cpp.git .

# CUDA 编译（限制并行数 -j2 避免 Docker Desktop OOM）
# 注意：devel 镜像无 libcuda.so.1 实体库，需链接 stub
# CMAKE_CUDA_ARCHITECTURES 含 89 = Ada / RTX 4090
# GGML_BUILD_*：无 git / 浅克隆时跳过 ggml 对 git 的 REQUIRED
RUN ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/libcuda.so.1 && \
    cmake -B build \
    -DGGML_CUDA=ON \
    -DBUILD_SHARED_LIBS=OFF \
    -DGGML_BUILD_NUMBER=5512 \
    -DGGML_BUILD_COMMIT=b5512 \
    -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
    -DCMAKE_CUDA_ARCHITECTURES="75;80;86;89" \
    -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build -j2 --target llama-server && \
    mkdir -p /out && \
    cp -a /build/build/bin/llama-server /out/ && \
    find /build/build -name '*.so*' -exec cp -a {} /out/ \;

# ── Stage 2: 精简运行镜像 ──
# llama.cpp 此 tag 动态链接 llama-server；只拷二进制会报 libllama.so 缺失
FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

RUN rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nvidia*.list || true; \
    chmod 644 /etc/apt/trusted.gpg.d/*.gpg || true; \
    apt-get update --allow-insecure-repositories && \
    apt-get install -y --no-install-recommends --allow-unauthenticated \
    curl libgomp1 libcurl4 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /out/ /opt/llama/bin/
COPY scripts/llama-entrypoint.sh /usr/local/bin/llama-entrypoint.sh

ENV LD_LIBRARY_PATH=/opt/llama/bin
RUN ln -sf /opt/llama/bin/llama-server /usr/local/bin/llama-server && \
    echo /opt/llama/bin > /etc/ld.so.conf.d/llama.conf && \
    ldconfig && \
    chmod +x /usr/local/bin/llama-entrypoint.sh

# 模型挂载点
RUN mkdir -p /models

EXPOSE 8080

# 健康检查（llama-server 自带 /health 端点）
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/llama-entrypoint.sh"]
CMD ["-m", "/models/Qwen_Qwen3-8B-Q4_K_M.gguf", "--host", "0.0.0.0", "--port", "8080", "-ngl", "99"]
