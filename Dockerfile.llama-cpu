# ═══════════════════════════════════════════════
# llama.cpp CPU 编译版 + server 运行镜像
#
# 使用方式:
#   docker build -f Dockerfile.llama-cpu -t agent1-llama-cpu .
#   docker run -p 8080:8080 \
#     -v /path/to/models:/models \
#     agent1-llama-cpu \
#     -m /models/Qwen_Qwen3-8B-Q4_K_M.gguf --host 0.0.0.0 --port 8080
# ═══════════════════════════════════════════════

# ── Stage 1: 编译 llama.cpp（无 CUDA）──
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git build-essential cmake libcurl4-openssl-dev ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

# 克隆 llama.cpp（repo 已迁移至 ggml-org，GitHub 自动 301 重定向）
# Qwen3 架构需要 >= b5092；与 GPU 镜像使用同一 tag
RUN git clone --depth 1 --branch b5092 \
    https://github.com/ggml-org/llama.cpp.git . || \
    git clone --depth 1 --branch b5092 \
    https://github.com/ggerganov/llama.cpp.git .

RUN cmake -B build \
    -DGGML_CUDA=OFF \
    -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build -j$(nproc) --target llama-server

# ── Stage 2: 精简运行镜像 ──
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl libgomp1 libcurl4 ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/build/bin/llama-server /usr/local/bin/llama-server
COPY --from=builder /build/build/bin/libllama.so /usr/local/lib/libllama.so
COPY --from=builder /build/build/bin/libggml.so /usr/local/lib/libggml.so
COPY --from=builder /build/build/bin/libggml-base.so /usr/local/lib/libggml-base.so
COPY --from=builder /build/build/bin/libggml-cpu.so /usr/local/lib/libggml-cpu.so
RUN ldconfig

RUN mkdir -p /models

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1

ENTRYPOINT ["llama-server"]
CMD ["-m", "/models/Qwen_Qwen3-8B-Q4_K_M.gguf", "--host", "0.0.0.0", "--port", "8080", "-ngl", "0"]
